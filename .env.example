# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/image_orchestrator

# Redis
REDIS_URL=redis://localhost:6379/0

# Provider API
PROVIDER_API_KEY=test_provider_api_key_12345
PROVIDER_ALLOW_INSECURE_HTTP=false
PROVIDER_BASE_URL=https://api.example.com/v1

# API key hashing
# Set this in production, then store HMAC-SHA256 hashes generated with this pepper.
API_KEY_HASH_PEPPER=change_me_to_a_long_random_secret

# Logging
LOG_LEVEL=INFO

# API docs
API_DOCS_ENABLED=false
